# syntax=docker/dockerfile:1
# Conteneur de développement (compose.dev.yaml, scripts/dev) : Python et uv seulement ; le
# dépôt est monté, l'environnement virtuel vit dans un volume (uv sync au premier lancement).
FROM python:3.13-slim-trixie
COPY --from=ghcr.io/astral-sh/uv:0.12.24 /uv /uvx /usr/local/bin/
RUN apt-get update \
 && apt-get install -y --no-install-recommends tzdata git \
 && rm -rf /var/lib/apt/lists/*
ENV UV_PROJECT_ENVIRONMENT=/venv \
    UV_CACHE_DIR=/cache/uv \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    PYTHONDONTWRITEBYTECODE=1 \
    TZ=Europe/Brussels
WORKDIR /src
