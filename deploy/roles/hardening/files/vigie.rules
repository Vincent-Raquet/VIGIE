## Vigie (SECURITY.md) : accès aux secrets, à la configuration et au code.
-w /etc/credstore.encrypted/ -p rwa -k vigie_secrets
-w /etc/vigie/ -p wa -k vigie_config
-w /srv/vigie/ -p wa -k vigie_code
-w /srv/edge/ -p wa -k edge
-w /etc/docker/ -p wa -k docker
-w /etc/systemd/system/ -p wa -k systemd_units
-w /etc/nftables.conf -p wa -k firewall
-w /etc/sudoers -p wa -k sudoers
-w /etc/sudoers.d/ -p wa -k sudoers
