# {{ ansible_managed }}
PermitRootLogin no
MaxAuthTries 3
LogLevel VERBOSE
TCPKeepAlive no
Banner /etc/issue.net
LoginGraceTime 30
X11Forwarding no
AllowAgentForwarding no
PermitUserEnvironment no
ClientAliveInterval 300
ClientAliveCountMax 2
{% if not vigie_dev_on_host %}
# Le développement a quitté la VM : plus de tunnel ni de sessions multiples.
AllowTcpForwarding no
MaxSessions 2
{% endif %}
{% if ssh_disable_password_auth %}
PasswordAuthentication no
KbdInteractiveAuthentication no
{% endif %}
{% if veeam_guest_enabled | default(false) %}

# Compte du traitement invité Veeam : connexion depuis le serveur Veeam seulement (le
# premier bloc Match qui s'applique l'emporte).
Match User {{ veeam_guest_user }} Address {{ veeam_guest_sources | join(',') }}
    PasswordAuthentication {{ 'yes' if veeam_guest_auth == 'password' else 'no' }}
    PubkeyAuthentication {{ 'yes' if veeam_guest_auth == 'key' else 'no' }}
    KbdInteractiveAuthentication no
    AllowTcpForwarding no
    X11Forwarding no
Match User {{ veeam_guest_user }}
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    PubkeyAuthentication no
    AllowTcpForwarding no
{% endif %}
