#!/usr/sbin/nft -f
# {{ ansible_managed }}
# SECURITY.md C6. Mode cohabitation dev : {{ 'OUI (sortie libre de l\'hôte)' if vigie_dev_on_host else 'NON (sortie de l\'hôte en drop)' }}.
# Docker gère ses propres tables (iptables-nft) : jamais de « flush ruleset », seule la table
# inet vigie est remplacée (la déclarer puis la supprimer rend le rechargement idempotent).
table inet vigie
delete table inet vigie

table inet vigie {
  set admin_networks { type ipv4_addr; flags interval; elements = { {{ admin_networks | join(', ') }} } }
  set lan_vpn_networks { type ipv4_addr; flags interval; elements = { {{ lan_vpn_networks | join(', ') }} } }
  set dns_servers { type ipv4_addr; elements = { {{ dns_servers | join(', ') }} } }
{# port d'une source : entier, ou liste (Wazuh tout-en-un : API 55000 et indexer 9200). #}
{% macro dports(p) %}{{ p if p is number else '{ ' ~ (p | join(', ')) ~ ' }' }}{% endmacro %}
{% set vigie_subnets = (vigie_networks.values() | map(attribute='subnet') | list)
                       + (vigie_source_egress | map(attribute='subnet') | list) + [vigie_jobs_subnet] %}
  # Réseaux Docker de Vigie : rien n'en sort hors des règles explicites de la chaîne forward.
  set vigie_subnets { type ipv4_addr; flags interval; elements = { {{ vigie_subnets | join(', ') }} } }

  chain input {
    type filter hook input priority filter; policy drop;
    iif lo accept
    ct state established,related accept
    ct state invalid drop
    meta l4proto { icmp, ipv6-icmp } accept
    tcp dport 22 ip saddr @admin_networks accept
{% if veeam_guest_sources | default([]) %}
    tcp dport 22 ip saddr { {{ veeam_guest_sources | join(', ') }} } accept comment "Veeam traitement invité"
{% endif %}
{% if not legacy_purge %}
    # Caddy natif (avant la bascule en conteneurs) ; ensuite, 443 est publié par Docker (forward).
    tcp dport 443 ip saddr @lan_vpn_networks accept
{% endif %}
    tcp dport 10050 ip saddr {{ zabbix_server }} accept
    limit rate 10/minute log prefix "nft-in-drop " level info
    counter drop
  }

  # Trafic des conteneurs (routé par l'hôte). Un « accept » ici n'est pas final : les chaînes
  # de Docker s'appliquent aussi ; un « drop » l'est toujours.
  # « limit » est une condition : il ne borne que la journalisation, jamais le rejet (sinon,
  # au-delà du débit, le paquet passerait à la règle suivante, ex. « br-* accept »).
  chain forward {
    type filter hook forward priority filter; policy drop;
    ct state established,related accept
    ct state invalid drop
    # Ports publiés (proxy d'entrée « edge », HTTPS) : depuis le LAN et le VPN seulement.
    ct status dnat ip saddr @lan_vpn_networks accept
    ct status dnat limit rate 10/minute log prefix "nft-pub-drop "
    ct status dnat counter drop

    # Vigie : échanges internes à chaque réseau (ex. web ↔ Squid).
{% for net in vigie_subnets %}
    ip saddr {{ net }} ip daddr {{ net }} accept
{% endfor %}
    # vigie-web : joint par Caddy sur « edge », n'ouvre jamais de connexion par ce réseau.
    ip saddr {{ vigie_web_edge_ip }} limit rate 10/minute log prefix "nft-web-drop "
    ip saddr {{ vigie_web_edge_ip }} counter drop
    # Squid : DNS et HTTPS, le filtrage par domaine est le sien.
    ip saddr {{ vigie_networks.egress.squid }} ip daddr @dns_servers meta l4proto { tcp, udp } th dport 53 accept
    ip saddr {{ vigie_networks.egress.squid }} tcp dport 443 accept
    # Collecte directe : chaque réseau de source vers sa seule source ; noms déclarés dans les
    # conteneurs (extra_hosts), donc aucun DNS.
{% for s in vigie_source_egress %}
    ip saddr { {{ s.subnet }}, {{ vigie_jobs_subnet }} } ip daddr {{ s.ip }} tcp dport {{ dports(s.port) }} accept comment "{{ s.name }}"
{% endfor %}
    ip saddr @vigie_subnets limit rate 10/minute log prefix "nft-vigie-drop "
    ip saddr @vigie_subnets counter drop

    # Autres applications du serveur : sortie depuis les ponts Docker.
    iifname "docker0" accept
    iifname "br-*" accept
    limit rate 10/minute log prefix "nft-fwd-drop "
    counter drop
  }

  chain output {
    type filter hook output priority filter; policy {{ 'accept' if vigie_dev_on_host else 'drop' }};
{% if not legacy_purge %}
    # Installation native (jusqu'à legacy_purge) : chaque compte vigie-* de l'hôte ne joint que
    # son port Squid, ses sources et le DNS. Sans effet sur les conteneurs (autre espace réseau).
    meta skuid "vigie-web" oif lo ct state new tcp dport != {{ squid_web_port }} counter drop
    meta skuid "vigie-worker" oif lo ct state new tcp dport != {{ squid_worker_port }} counter drop
    meta skuid "vigie-migrate" oif lo ct state new counter drop
{% endif %}
    oif lo accept
    ct state established,related accept
    meta l4proto { icmp, ipv6-icmp } accept
{% if not legacy_purge %}
    meta skuid "vigie-web" limit rate 10/minute log prefix "nft-web-drop "
    meta skuid "vigie-web" counter drop
    meta skuid "vigie-migrate" counter drop
    meta skuid "vigie-worker" ip daddr @dns_servers meta l4proto { tcp, udp } th dport 53 accept
{% for s in vigie_source_egress %}
    meta skuid "vigie-worker" ip daddr {{ s.ip }} tcp dport {{ dports(s.port) }} accept comment "{{ s.name }}"
{% endfor %}
    meta skuid "vigie-worker" limit rate 10/minute log prefix "nft-worker-drop "
    meta skuid "vigie-worker" counter drop
{% endif %}
{% if not vigie_dev_on_host %}

    # Hors cohabitation : sorties du système lui-même (les conteneurs passent par forward).
    ip daddr @dns_servers meta l4proto { tcp, udp } th dport 53 accept
    meta skuid { "root", "_apt" } tcp dport { 80, 443 } accept comment "mises à jour, images Docker"
    meta skuid "_chrony" udp dport 123 accept
    meta skuid "zabbix" ip daddr {{ zabbix_server }} tcp dport 10051 accept
    limit rate 10/minute log prefix "nft-out-drop "
    counter drop
{% endif %}
  }
}
