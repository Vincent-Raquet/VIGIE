# {{ ansible_managed }}
# Proxy sortant de Vigie (SECURITY.md C6), conteneur « squid » de compose.yaml : CONNECT 443
# vers une allowlist de domaines. Chaque port n'écoute que sur un réseau Docker interne et
# n'accepte que ce réseau : {{ squid_worker_port }} pour les tâches et la discussion (IA, Graph, Teams),
# {{ squid_web_port }} pour vigie-web (Entra seul). nftables ne laisse sortir que ce conteneur.

http_port {{ vigie_networks.worker.squid }}:{{ squid_worker_port }} name=worker
http_port {{ vigie_networks.web.squid }}:{{ squid_web_port }} name=web

acl worker_port myportname worker
acl web_port myportname web
acl worker_net src {{ vigie_networks.worker.subnet }}
acl web_net src {{ vigie_networks.web.subnet }}
acl SSL_ports port 443
acl Safe_ports port 443
acl CONNECT method CONNECT
acl worker_domains dstdomain {{ (squid_worker_domains + squid_teams_domains) | join(' ') }}
acl web_domains dstdomain {{ squid_web_domains | join(' ') }}

http_access deny !CONNECT
http_access deny !Safe_ports
http_access deny !SSL_ports
http_access allow worker_port worker_net worker_domains
http_access allow web_port web_net web_domains
http_access deny all

cache deny all
reply_body_max_size 50 MB
cache_mem 8 MB
via off
forwarded_for delete
httpd_suppress_version_string on
visible_hostname vigie-squid
pinger_enable off
# Conteneur en lecture seule : journaux vers journald (pilote de compose), état en tmpfs.
access_log stdio:/dev/stdout squid
cache_log /dev/stderr
logfile_rotate 0
pid_filename /run/squid/squid.pid
dns_nameservers {{ dns_servers | join(' ') }}
coredump_dir /var/spool/squid
