# {{ ansible_managed }}
# Source {{ source.name }} : son seul secret et ses seules adresses (SECURITY.md C7, C8).
[Service]
{% for name in source.secrets %}
LoadCredentialEncrypted={{ name }}:/etc/credstore.encrypted/vigie.{{ name }}
{% endfor %}
IPAddressAllow={{ (dns_servers + (vigie_source_egress | selectattr('name', 'equalto', source.name) | map(attribute='ip') | list)) | join(' ') }}
