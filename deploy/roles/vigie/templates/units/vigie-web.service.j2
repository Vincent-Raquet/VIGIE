# {{ ansible_managed }}
[Unit]
Description=Vigie — interface web
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=exec
User=vigie-web
Group=vigie-web
SupplementaryGroups=vigie
ExecStart={{ vigie_bin }} web
Restart=on-failure
RestartSec=5
# Aucun secret de source ni clé IA (SECURITY.md C10) : session et connexion Entra seulement.
{% for name in vigie_web_credentials %}
LoadCredentialEncrypted={{ name }}:/etc/credstore.encrypted/vigie.{{ name }}
{% endfor %}
# Sortie : Squid (port web, login.microsoftonline.com seul).
Environment=HTTPS_PROXY=http://127.0.0.1:{{ squid_web_port }}
Environment=NO_PROXY=127.0.0.1,localhost
IPAddressDeny=any
IPAddressAllow=localhost
{% include 'units/_sandbox.j2' %}
