# {{ ansible_managed }}
# Site de Vigie sur le proxy d'entrée partagé (rôle edge) ; vigie-web n'est joignable que
# par le réseau Docker « edge ».
{{ vigie_domain }} {
	tls internal
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		-Server
	}
	reverse_proxy vigie-web:{{ vigie_web_port }}
	log {
		output stdout
		format json
	}
}
