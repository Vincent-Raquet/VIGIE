#!/bin/sh
# Dépôt des secrets de Vigie (point C de la roadmap) : la valeur est lue sur l'entrée standard,
# chiffrée par systemd-creds (clé de la machine) et jamais écrite en clair ni affichée.
#   printf '%s' "$VALEUR" | sudo vigie-secret set anthropic_api_key
#   sudo vigie-secret set graph_certificate < cle-et-certificat.pem
#   sudo vigie-secret list | rm <nom>
set -eu
STORE=/etc/credstore.encrypted
usage() { echo "usage : vigie-secret set|rm <nom> | list" >&2; exit 2; }
[ "$(id -u)" -eq 0 ] || { echo "à lancer avec sudo" >&2; exit 1; }
[ $# -ge 1 ] || usage
install -d -m 0700 -o root -g root "$STORE"
case "$1" in
  list)
    find "$STORE" -maxdepth 1 -name 'vigie.*' -printf '%f\n' | sed 's/^vigie\.//' | sort ;;
  set|rm)
    [ $# -eq 2 ] || usage
    name=$2
    case "$name" in ''|*[!a-z0-9_]*) echo "nom invalide (a-z, 0-9, _)" >&2; exit 2 ;; esac
    file="$STORE/vigie.$name"
    if [ "$1" = rm ]; then rm -f "$file"; echo "secret $name supprimé"; exit 0; fi
    [ -t 0 ] && echo "valeur attendue sur l'entrée standard (Ctrl-D pour terminer)" >&2
    umask 077
    systemd-creds encrypt --name="$name" - "$file.tmp"
    mv "$file.tmp" "$file"
    logger -t vigie-secret "secret $name déposé par ${SUDO_USER:-root}"
    echo "secret $name enregistré ; redémarrer l'unité qui l'utilise" ;;
  *) usage ;;
esac
