{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(**/*.cred)",
      "Read(**/credstore*/**)",
      "Read(//etc/credstore/**)",
      "Read(//etc/credstore.encrypted/**)",
      "Read(~/.ssh/**)",
      "Bash(cat .env*)",
      "Bash(printenv*)",
      "Bash(env)",
      "Bash(*systemd-creds decrypt*)",
      "Bash(*systemd-creds cat*)",
      "Bash(rm -rf /*)",
      "Bash(git push --force*)",
      "Read(//run/vigie/**)"
    ],
    "ask": [
      "Bash(sudo *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(ansible-playbook *)",
      "Bash(ansible *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git push*)",
      "Bash(docker *)",
      "Bash(uv run vigie collect*)",
      "Bash(uv run vigie notify*)",
      "Bash(uv run scripts/record_fixtures.py*)",
      "Edit(./CLAUDE.md)",
      "Edit(./.claude/**)",
      "Bash(scripts/dev vigie collect*)",
      "Bash(scripts/dev vigie notify*)",
      "Bash(scripts/dev python scripts/record_fixtures.py*)"
    ],
    "allow": [
      "Bash(uv sync*)",
      "Bash(uv add *)",
      "Bash(uv lock*)",
      "Bash(uv run pytest*)",
      "Bash(uv run ruff*)",
      "Bash(uv run mypy*)",
      "Bash(uv run alembic*)",
      "Bash(uv run vigie --help*)",
      "Bash(uv run vigie check*)",
      "Bash(uv run vigie plan * --dry-run*)",
      "Bash(uv run vigie seed*)",
      "Bash(uv run pre-commit*)",
      "Bash(uv run pip-audit*)",
      "Bash(gitleaks *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git log*)",
      "Bash(rg *)",
      "Bash(scripts/dev pytest*)",
      "Bash(scripts/dev lint*)",
      "Bash(scripts/dev ruff*)",
      "Bash(scripts/dev mypy*)",
      "Bash(scripts/dev vigie --help*)",
      "Bash(scripts/dev vigie check*)",
      "Bash(scripts/dev vigie plan * --dry-run*)",
      "Bash(scripts/dev vigie seed*)"
    ]
  }
}
